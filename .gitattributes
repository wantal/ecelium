# Source files - normalize line endings to LF
*.rs        text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.txt       text eol=lf

# Binary assets - no line ending conversion
*.wasm      binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary

# JS files in dist/ - treat as binary to preserve SRI hashes
dist/*.js   binary
dist/*.css  binary
dist/*.wasm binary
